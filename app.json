{
  "expo": {
    "name": "Nutripick-App",
    "slug": "Nutripick-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutripickapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutripick.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "식단 사진을 선택하기 위해 사진 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "식단 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.nutripick.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "식단 사진을 선택하기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "식단 사진을 촬영하기 위해 카메라 접근 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
